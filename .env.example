# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Runtime mode. Production startup fails closed when required secrets are absent.
FUSION_ENV=production
FUSION_SECURITY_MODE=production
JWT_SECRET_KEY=CHANGE_THIS_TO_32_CHARS_MIN
JWT_ISSUER=fusion-risk-os
JWT_AUDIENCE=fusion-platform
JWT_TTL_SECONDS=900
CORS_ORIGINS=https://dashboard.example.com

# JSON map of client IDs to secrets, roles, and optional tenant/app scopes.
FUSION_AUTH_CLIENTS_JSON={"replace-client":{"secret":"replace-secret","roles":["admin"],"permissions":["*"] ,"tenant_id":"TENANT_001","app_id":"com.fuzenbank.mobileapp"}}

# Banking identities. Use password_hash (PBKDF2-SHA256 format) in production
# rather than plaintext password. Plaintext is accepted only as configuration
# input and is immediately converted to a one-way hash in persistent storage.
FUSION_BANK_USERS_JSON={"admin_tenant":{"password":"PLACEHOLDER","role":"admin","tenant_id":"TENANT_001"}}
DATABASE_URL=./finspark.db
BANK_REFRESH_TTL_SECONDS=2592000
DB_PATH=./finspark.db

# Default tenant and app assigned to self-registered users.
# Override for each deployment/customer.
FUSION_DEFAULT_TENANT_ID=TENANT_FUSB_001
FUSION_DEFAULT_APP_ID=com.fusionbank.mobileapp

# Neo4j. If unset, the runtime explicitly reports NETWORKX_FALLBACK.
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-generated-password
GRAPH_FALLBACK_ENABLED=true

# Kaggle credentials are NOT set here — the kaggle CLI reads ~/.kaggle/kaggle.json directly.
# Do not add a Kaggle token to this file.

# 32-byte Ed25519 private key encoded as 64 hexadecimal characters.
LEDGER_SIGNING_KEY=replace-with-64-hex-characters

# Gateway Webhook Secret
GATEWAY_WEBHOOK_SECRET=your-gateway-secret
GATEWAY_TENANT_ID=TENANT_001

# Identity Trust / Supabase (backend only; never expose service role key to the APK or Vercel browser bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
IDENTITY_SUPABASE_REQUIRED=false

# Customer security email delivery
SECURITY_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-api-key
SECURITY_EMAIL_FROM=Fusion Security <security@your-verified-domain.example>

# Optional IP intelligence provider. Android attestation headers remain supported without this key.
IPQUALITYSCORE_API_KEY=your-ipqualityscore-key
